{
  "name": "porsche-coder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Porsche 981 编码工具（vLinker MS 专用）",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "ios": "npm run sync && npx cap sync ios && npx cap open ios",
    "ios:run": "npm run sync && npx cap sync ios && npx cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "esbuild": "^0.25.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
